# Login password for the hub (single user)
HELM_PASSWORD=change-me-long-random

# Signs the session cookie. Generate: openssl rand -base64 32
HELM_SESSION_SECRET=

# Encrypts stored secrets (DB passwords, API keys). Generate: openssl rand -base64 32
# Keep a copy in your password manager. If it is lost, stored secrets cannot be read.
HELM_ENCRYPTION_KEY=

# Optional
HELM_DATA_FILE=            # default: apps/hub/data/helm.json
HELM_CHECK_INTERVAL_SEC=60 # how often the hub checks URLs

# Google Drive for backups (set on the hub). One Google account, drive.file scope.
HELM_GOOGLE_CLIENT_ID=
HELM_GOOGLE_CLIENT_SECRET=
HELM_GOOGLE_REFRESH_TOKEN=

# Telegram alerts (set on the hub). Leave blank to only log alerts.
HELM_TELEGRAM_BOT_TOKEN=
HELM_TELEGRAM_CHAT_ID=

# Collector (set on each server, not in the hub)
HELM_HUB_URL=https://helm.example.com
HELM_COLLECTOR_TOKEN=      # shown once when you rotate a project's token in the hub
HELM_LOG_FILES=            # comma-separated log paths to scan for errors
HELM_INTERVAL_SEC=30
