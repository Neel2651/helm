# Helm — reverse proxy template.
#
# Copy this to your server's Nginx sites directory, replace helm.example.com
# with your real hostname, point DNS at the server, then get a certificate
# (e.g. `certbot --nginx -d helm.example.com`) and reload Nginx.
#
# Helm itself binds to 127.0.0.1:3100 — see ecosystem.config.js. It is never
# exposed directly; only through this proxy, over HTTPS.

upstream helm_hub { server 127.0.0.1:3100; }

server {
    listen 80;
    server_name helm.example.com;

    location / {
        proxy_pass http://helm_hub;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
